{
  "name": "last",
  "version": "0.1.0",
  "private": true,
  "description": "Browse and continue your local Claude Code sessions from the browser.",
  "license": "Apache-2.0",
  "author": "shunjid (https://github.com/shunjid)",
  "homepage": "https://github.com/shunjid/last#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shunjid/last.git"
  },
  "bugs": {
    "url": "https://github.com/shunjid/last/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "sessions",
    "transcripts",
    "local",
    "nextjs",
    "cli"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4123",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4123",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check-bind": "lsof -nP -iTCP:4123 -sTCP:LISTEN || echo 'nothing listening on 4123'",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.124.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@shikijs/langs": "4.4.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.4.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
